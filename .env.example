# Copy to `.env` and fill in locally. `.env` is gitignored — never commit real values.

# GCP Cloud Billing Catalog API key. Without it the GCP fetcher throws and the
# provider honestly stays on the seeded benchmark (see scripts/fetchers/gcp.mjs).
GCP_API_KEY=

# IBM Cloud API key (IAM). Without it the IBM fetcher throws and the provider
# honestly stays on the seeded benchmark (see scripts/fetchers/ibm.mjs).
IBM_CLOUD_API_KEY=

# Vultr API key. Compute syncs live WITHOUT it (the plans endpoint is open);
# only the managed-database section needs it, and stays on the seeded benchmark
# when it is absent (see scripts/fetchers/vultr.mjs). Export it in your shell
# (`node --env-file=.env scripts/sync-prices.mjs` loads this file).
VULTR_API_KEY=
