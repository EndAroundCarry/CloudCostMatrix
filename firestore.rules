rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Saved architecture estimates — a user may only read/write their own library.
    match /estimates/{userId}/items/{estimateId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Live pricing snapshot mirrored by scripts/sync-prices.mjs via the Admin SDK
    // (which bypasses these rules). Public read, no client writes.
    match /pricing/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
